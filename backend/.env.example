# DATA PILOT AI - Environment Configuration

# LLM Provider Configuration ("openai", "gemini", or "auto")
# If no API key is provided, the platform automatically uses the intelligent Dynamic Semantic Planner!
LLM_PROVIDER=auto

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (SQLite default for zero-config local run; PostgreSQL-ready)
DATABASE_URL=sqlite:///./datapilot.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/datapilot

# Server Configuration
API_V1_STR=/api
PROJECT_NAME=DATA PILOT AI
