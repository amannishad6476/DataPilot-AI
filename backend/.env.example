# DATA PILOT AI - Production & Development Environment Configuration

# -----------------------------------------------------------------------------
# 1. LLM Provider Configuration ("openai", "gemini", or "auto")
# If no API key is provided, the platform automatically uses the intelligent
# Dynamic Semantic Planner with zero external dependencies!
# -----------------------------------------------------------------------------
LLM_PROVIDER=auto

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# 2. Database Configuration
# SQLite default for zero-config local run; PostgreSQL recommended in production.
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./datapilot.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/datapilot

# -----------------------------------------------------------------------------
# 3. Security, Multi-Tenancy & Access Control
# Set JWT/API secrets for production deployments.
# Default zero-config fallback to local owner enabled if headers omitted.
# -----------------------------------------------------------------------------
DEFAULT_TENANT_ID=tenant_default
DEFAULT_PROJECT_ID=proj_default
# Comma-separated list of permitted API keys (format: token:ROLE)
# API_KEYS="dp_live_prod_key_1:OWNER,dp_live_prod_key_2:MEMBER"

# -----------------------------------------------------------------------------
# 4. Rate Limiting & Safety Boundaries
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=120
MAX_RECORDS_PER_WORKFLOW=500
CONNECTOR_CIRCUIT_BREAKER_FAILURES=3
CONNECTOR_CIRCUIT_BREAKER_RECOVERY_SEC=30

# -----------------------------------------------------------------------------
# 5. Server & Logging
# -----------------------------------------------------------------------------
API_V1_STR=/api
PROJECT_NAME=DATA PILOT AI
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=production
